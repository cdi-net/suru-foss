# SURU Platform — Tier 1 Perimeter Environment Variables
# Copy to .env and fill in real values. Never commit .env to git.
# Secrets must never be hardcoded — source from env vars or SOPS/age.

# ---- Router target ----
# IP or hostname of the pfSense / OPNsense router
ROUTER_HOST=192.168.1.1
ROUTER_SSH_USER=admin
# Path to SSH private key for router access (key-based auth required)
ROUTER_SSH_KEY=~/.ssh/suru_tier1_ed25519
# SSH host key checking behaviour (passed to -o StrictHostKeyChecking=).
# Accepted values: yes | accept-new | no
# Script default when unset: yes (strict — requires the key to be in known_hosts).
# For first-time provisioning where the router is not yet in known_hosts, set:
#   SSH_STRICT_HOST_KEY_CHECKING=accept-new
# (trusts new keys on first connect; rejects changed keys on subsequent connects)
# Revert to yes immediately after initial provisioning.
# SSH_STRICT_HOST_KEY_CHECKING=yes

# ---- Platform driver selection ----
# Which platform driver to use: pfsense | opnsense
# Can be overridden at runtime with --platform <name>
ROUTER_PLATFORM=pfsense

# ---- Hardware preflight (adaptive tuning) ----
# 'make deploy' runs a best-effort preflight (preflight → render → deploy) that
# SSH-detects router hardware (hw.ncpu / hw.physmem / df /) and writes a
# hardware profile to the router (/usr/local/etc/suru/hw-profile.conf) and a
# local mirror (tier1-perimeter/.hw-profile, gitignored). The profile tunes
# pfBlockerNG pf table-entries, Zeek lb_procs, and the Suricata detect profile +
# memcaps. Implemented in scripts/lib/hw-preflight.sh.
#
# Set true to skip hardware detection entirely (e.g. in CI, or when the router
# is not reachable). deploy then uses the conservative built-in defaults
# (4 GB / 4-core profile: pf table-entries 800000, Zeek lb_procs 2,
# Suricata profile medium). Default when unset: false.
# SURU_SKIP_HW_PREFLIGHT=false

# Set false to skip the pfSense Suricata engine-tuning applier
# (suricata-tuning-apply.php, which sets detect_eng_profile per interface) while
# still running preflight/detection. Default when unset: true (tuning applied).
# SURU_SURICATA_TUNING=true

# ── Tier 4 frontdoor (single ingress on port 443) ──────────────────────────
# Hostname that syslog-ng presents as SNI when connecting to the frontdoor.
# The nginx stream block routes this SNI to logstash-pfsense:5140 (TCP passthrough).
# Add a pfSense DNS host override: syslog.suru.local → <frontdoor-LAN-IP>
FRONTDOOR_SYSLOG_SNI=syslog.suru.local
# Port for all Tier 1 → frontdoor connections (443 = literal port 443 requirement).
FRONTDOOR_PORT=443

# ---- Network interfaces ----
# Suricata interfaces — comma-separated list of PHYSICAL NIC names ONLY
# (e.g. igb1,igb2 / eth0,eth1). One Suricata instance per physical NIC.
# BREAKING CHANGE (2026-07): pfSense logical aliases (lan, opt1, …) and VLAN
# sub-interfaces (igb1.10) are REJECTED at deploy time. On pfSense the deploy
# resolves each NIC to a carrier alias internally (suru-iface-resolve.php);
# you never list aliases here. Same contract as ZEEK_IFACE below.
# Capture semantics per SURICATA_IPS_MODE:
#   inline: netmap opens the NIC itself — all VLANs on a trunk are inspected
#           by the one instance (pfSense package auto-redirects VLAN->parent).
#   legacy: pcap attaches to the carrier's real interface, which on a trunk is
#           a VLAN sub-if (e.g. igb1.10) — only that VLAN is seen. Documented
#           transitional limitation; inline is the target state.
# Multi-interface example: SURICATA_IFACES=igb1,igb2
# Single-interface example: SURICATA_IFACES=igb1
SURICATA_IFACES=igb1

# Suricata capture/enforcement mode (pfSense XML ips_mode). Default: legacy.
#   legacy — pcap capture + reactive pf-table block (offender IP blocked after
#            the triggering packet has passed). Zero datapath risk.
#   inline — netmap in-flight drop on the physical NIC. Suricata becomes part
#            of the datapath: a wedged engine interrupts traffic on that NIC.
#            Flip only after the inline-flip soak checklist in the Tier 1 README.
# SURICATA_IPS_MODE=legacy

# Explicit netmap thread count (1-8) for inline mode. Unset = computed on the
# router as min(NIC netmap queues, ncpu/2) — never 'auto' (FreeBSD threading
# quirk).
# SURICATA_NETMAP_THREADS=2

# Inline-flip dead-man's-switch. When SURICATA_IPS_MODE=inline, the deploy arms
# a router-side auto-revert BEFORE flipping (the flip can drop the host stack on
# the NIC carrying ROUTER_HOST — the deploy's own SSH path). If the deploy loses
# SSH mid-flip and never reaches its disarm call, the router reverts Suricata to
# legacy after SURU_SAFETY_REVERT_SECONDS, restoring management. On success the
# deploy disarms it — no residue. Runs via daemon(8) (FreeBSD; pfSense/OPNsense).
# Set false to disable the safety net (NOT recommended for a remote inline flip).
# SURU_SAFETY_TIMER=true
# Auto-revert window in seconds (min 30). Default 600 (10 min) — long enough for
# the two Suricata restarts to settle, short enough to bound a lockout.
# SURU_SAFETY_REVERT_SECONDS=600

# Inline-drop policy — ET categories converted alert->drop so inline mode
# actually enforces (hard precondition for SURICATA_IPS_MODE=inline: inline
# netmap enforces ONLY via drop rules; the legacy pf-table block plugin is off
# in inline mode). STAGED in legacy (inert — the package gates the conversion
# on inline, suricata.inc:2915), ACTIVATES atomically on the inline flip.
# Default (when UNSET) = the proven-low-FP CRITICAL set. Set to an explicit
# EMPTY value (SURICATA_DROP_CATEGORIES=) to REVERT an applied policy — the
# deploy passes the empty list through and the applier removes the drop list,
# clears drop_sid_file, and turns auto_manage_sids off.
# SURICATA_DROP_CATEGORIES=emerging-botcc,emerging-malware,emerging-exploit,emerging-attack_response
# SURU_SURICATA_DROP_POLICY=false SKIPS the drop-policy step — it does NOT
# revert an already-applied policy (existing drop list stays in config.xml).
# To actually remove an applied policy, use SURICATA_DROP_CATEGORIES= (empty)
# with the policy left enabled.
# SURU_SURICATA_DROP_POLICY=true

# Legacy single-interface alias (deprecated — use SURICATA_IFACES above).
# Honoured as a fallback when SURICATA_IFACES is unset. Physical NIC only.
# SURICATA_IFACE=em0

# Zeek capture interface — physical trunk interface name (e.g. igb1, em0).
# deploy sets this in THREE places via the pfSense PHP API (GUI-visible):
#   1. installedpackages/zeek/config/0/active_interface in config.xml
#   2. /usr/local/etc/node.cfg  (zeekctl's capture interface source of truth)
#   3. zeek_iface const label in rendered/zeek/local.zeek (informational)
#
# Use the trunk (parent) interface, not a VLAN sub-interface:
#   igb1      ← correct: Zeek decodes 802.1Q natively, one sensor covers all VLANs
#   igb1.10   ← wrong: only sees VLAN 10; other VLANs invisible
#   lan       ← wrong: pfSense logical name resolves to igb1.10 (VLAN sub-iface)
ZEEK_IFACE=igb1

# Email address for zeekctl alert emails (log rotation warnings, host-up/down).
# Baked into rendered/zeek/zeekctl.cfg at render time.
# Defaults to root (local delivery only) when unset.
ZEEK_MAILTO=

# -----------------------------------------------------------------------------
# unbound local-zones platform default. Answers special-use/local namespaces
# locally so they are never forwarded upstream. SURU adds the names unbound
# does NOT ship as built-in defaults: `local.` (RFC 6762 mDNS — leaks to
# public roots otherwise), `alt.` (RFC 9476 non-DNS namespace), and the two
# name-hijack guards from Microsoft's DNS Global Query Block List —
# `wpad.<system domain>.` (rogue proxy auto-discovery) and
# `isatap.<system domain>.` (rogue ISATAP gateway) — all always_nxdomain. The
# other IANA special-use names (invalid/localhost/onion/home.arpa/resolver.arpa/
# service.arpa/test/reverse zones) are unbound built-in defaults and are NOT
# duplicated; ipv4only.arpa/example.* are deliberately left resolvable. The
# <system domain> is read from the router config (System > General > Domain),
# never hardcoded. Managed as a SURU sentinel block in the DNS Resolver custom
# options (operator content preserved); applied by
# pfsense/unbound-localzones-apply.php (pfSense-specific; OPNsense support not
# yet implemented), which re-asserts the pfBlockerNG python module after the
# resolver reconfigure and verifies from live config. Default when unset: true.
# SURU_UNBOUND_LOCALZONES=true
#
# Make the router's system domain (System > General > Domain) locally
# authoritative — DNS Resolver `system_domain_local_zone_type` set to `static`
# so names WITH a host-override resolve and unknown internal names get a LOCAL
# NXDOMAIN instead of being forwarded upstream (which both leaks internal
# hostnames and, with a self-referential domain-override, loops to SERVFAIL —
# live-observed 2026-08-31). Default when unset: true. The applier auto-skips
# this when a domain-override forwards the system domain to a NON-local (real
# internal) DNS server, so split-horizon setups are safe; set false to
# force-skip regardless (keeps the .local/wpad hardening).
# SURU_UNBOUND_SYSTEM_DOMAIN_STATIC=true
#
# -----------------------------------------------------------------------------
# Zeek DNS telemetry scope. mDNS/DNS-SD service-discovery chatter on UDP/5353
# was ~70% of all DNS events on the live baseline (1.5M of 2.15M in 30d) with
# no per-record security value. Default (false/unset): mDNS records are
# dropped from dns.log before shipping — saving router bandwidth, ingest CPU,
# OpenSearch storage/indexing, and detector scan cost end-to-end. This filters
# the LOG stream ONLY; Zeek detection scripts (DNS entropy/length legs,
# LLMNR/NBT-NS poisoning) run on the live event stream and still fire on
# mDNS-borne attacks regardless. Set true to restore full mDNS capture for an
# investigation (then redeploy). Rendered into local.zeek by render-zeek.sh.
# ZEEK_LOG_MDNS=false
#
# Authorized AD domains for the foreign-domain member-device detection
# (suru-foreign-domain.zeek). Comma-separated; a device performing
# AD-membership discovery (_ldap._tcp/_kerberos/_msdcs/wpad) for a domain
# OUTSIDE this set raises ForeignDomain_Member_Device (with its DHCP-known
# hostname/MAC). Default (unset): the router's own configured system domain,
# substituted at apply time by zeek-scripts-apply.php — set this only when
# the deployment legitimately hosts members of ADDITIONAL domains. Per-device
# exceptions (an accepted guest): redef exempt_hosts in local.zeek. Entries must be plain DNS names — a-z/0-9/hyphen labels,
# dot-separated, at least two labels (the same shape the policy layer
# enforces on domain entries); the render fails on anything else because
# the value is spliced into executed Zeek source.
# SURU_AUTHORIZED_AD_DOMAINS=corp.example,branch.example

# =============================================================================
# REST API Integration (post-deploy validation, error analysis, rule reloads)
# =============================================================================
# pfSense uses pfRest (https://pfrest.org/).
# OPNsense uses its native API (https://docs.opnsense.org/development/api.html).
#
# When credentials are unset, the SSH-only deploy path remains functional;
# only the post-deploy API validation and error-analysis features are skipped.
# -----------------------------------------------------------------------------

# Common
# TLS verification on router API. Leave "yes" in production. Disabling triggers
# a runtime WARN log line — only acceptable for lab/known self-signed certs.
API_TLS_VERIFY=yes
API_CONNECT_TIMEOUT=30
API_MAX_TIME=60

# -----------------------------------------------------------------------------
# AUTHENTICATION MODE
# -----------------------------------------------------------------------------
#   api_key  — long-lived static key. RECOMMENDED FOR AUTOMATION / CI.
#              Rotate quarterly. Both platforms supported.
#   jwt      — short-lived bearer token (pfSense only). BEST FOR INTERACTIVE
#              OPERATOR SESSIONS. The script logs in with username/password
#              and uses the returned JWT for the rest of the session.
#              Token is cached in-process only and never written to disk.
# -----------------------------------------------------------------------------
API_AUTH_MODE=api_key

# ---- pfSense / pfRest -------------------------------------------------------
# URL to the pfSense-pkg-RESTAPI .pkg matching your pfSense version.
# See https://pfrest.org/ for current releases. Used ONCE on first deploy by
# api_pfsense_install to install pfRest as the first package.
# Example:
#   PFSENSE_API_PKG_URL=https://github.com/pfrest/pfSense-pkg-RESTAPI/releases/download/v2.7.7/pfSense-2.8.1-pkg-RESTAPI.pkg
PFSENSE_API_PKG_URL=

# pfRest base URL (default: https://${ROUTER_HOST}/api/v2)
# PFSENSE_API_URL=https://192.168.1.1/api/v2

# --- pfSense: API_AUTH_MODE=api_key (recommended for automation) -----------
# Generated by: make api-bootstrap  (uses ROUTER_SSH_KEY above — no extra password needed)
# Rotate every 90 days: make api-bootstrap
PFSENSE_API_KEY=

# --- pfSense: API_AUTH_MODE=jwt (recommended for short-lived operator runs)-
# Used to obtain short-lived JWTs from /api/v2/auth/jwt.
# IMPORTANT: PFSENSE_API_PASSWORD is high-sensitivity — store the .env file
# encrypted with SOPS + age, or use a secret manager. Do NOT commit.
# PFSENSE_API_USERNAME=
# PFSENSE_API_PASSWORD=

# ---- OPNsense (native API) --------------------------------------------------
# OPNsense's native API only supports api_key mode (key+secret). JWT is
# NOT supported by OPNsense core — setting API_AUTH_MODE=jwt with
# ROUTER_PLATFORM=opnsense will fail loudly at api_init time.
#
# API base URL (default: https://${ROUTER_HOST}/api)
# OPNSENSE_API_URL=https://192.168.1.1/api

# Created in OPNsense UI: System -> Access -> Users -> [user] -> API keys.
# Downloaded as a key=value file; copy the two fields below.
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=

# ---- API integration toggles ------------------------------------------------
# Set true to skip pfRest install during deploy (e.g. if you manage it
# out-of-band or you're on a network without internet egress).
# SURU_SKIP_API_INSTALL=false

# Set true to skip post-deploy API health/validation calls entirely.
# SURU_SKIP_API_VALIDATE=false

# =============================================================================
# Encrypted pre-deploy backup
# =============================================================================
# Every deploy snapshots /conf/config.xml on the router BEFORE any change,
# encrypts it on the router via the platform's native crypt.inc helpers
# (AES-256-CBC + PBKDF2 sha256, 500_000 iterations — same code path the GUI's
# "Encrypt this configuration file" checkbox runs), and SCP-pulls the result
# into tier1-perimeter/backups/. On any deploy-step failure the driver
# auto-restores from this backup.
#
# REQUIRED unless SURU_SKIP_BACKUP=true. Set a strong passphrase. Store the
# .env via SOPS + age so this secret is never committed.
#
# The encrypted file is restorable from the router GUI:
#   pfSense:  Diagnostics > Backup & Restore > Restore Configuration
#             (check "Configuration file is encrypted", supply password)
#   OPNsense: System > Configuration > Backups > Restore (encrypted)
# -----------------------------------------------------------------------------
SURU_BACKUP_PASSWORD=

# Set true to disable the pre-deploy backup step entirely. Strongly discouraged
# — without this the deploy has no automatic rollback if a write_config fails
# midway. Only acceptable for first-deploy-on-throwaway-lab scenarios.
# SURU_SKIP_BACKUP=false

# -----------------------------------------------------------------------------
# pfBlockerNG IP Configuration — GeoIP (MaxMind) + ASN (IPinfo)
# -----------------------------------------------------------------------------
# When set, the deploy auto-enables pfBlockerNG's IP-config features (IP tab):
#   MAXMIND_ACCOUNT_ID + MAXMIND_LICENSE_KEY -> GeoIP country lookups + daily
#                          auto-update (pfBlockerNG `maxmind_account`,
#                          `maxmind_key`, `autogeoipupdate=on`). BOTH are
#                          required — GeoLite2 (GeoIP Update 3.1.1+) needs the
#                          account ID and the license key together.
#   IPINFO_TOKEN        -> ASN reporting, 24h cache (`asn_reporting=24hour`,
#                          `asn_token`)
# Each feature is enabled independently; leave its token(s) blank to keep it off.
# Free accounts:
#   MaxMind GeoLite2:  https://www.maxmind.com/en/geolite2/signup
#   IPinfo:            https://ipinfo.io/signup
# These are secrets — store the .env via SOPS + age; never commit real values.
# Note: the same MAXMIND_ACCOUNT_ID + MAXMIND_LICENSE_KEY are used by Tier 3
# (Logstash geoip) for the GeoLite2 download — keep them identical across tiers.
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
IPINFO_TOKEN=

# -----------------------------------------------------------------------------
# pfBlockerNG IP Reputation — AbuseIPDB blacklist feed (SURU_AbuseIPDB)
# -----------------------------------------------------------------------------
# API key for the SURU_AbuseIPDB feed row in SURU_IP_REP
# (tier2-telemetry/pfblockerng/categories/ip-categories.yml). The feed URL in
# the rendered importer carries an @@ABUSEIPDB_API_KEY@@ token; the deploy
# substitutes this value into the staged copy only (rendered/ stays
# secret-free). If left blank, the deploy DROPS the feed row entirely — the
# feed is simply absent from pfSense until a key is provided and the next
# deploy runs. Key charset must be alphanumeric (validated at deploy).
# Free account: https://www.abuseipdb.com/account/api  (blacklist endpoint,
# free plan caps at 10,000 entries — well within the pf table-entry budget).
# The key lands in the feed URL inside the router's config.xml (same exposure
# model as pfBlockerNG's own maxmind_key); config backups are encrypted.
ABUSEIPDB_API_KEY=

# =============================================================================
# Dynamic Perimeter Block (T0b) — pfSense only
# =============================================================================
# New Tier-1 enforcement surface: single-IP add/remove on a dedicated firewall
# alias via lib/api.sh's api_block_ip / api_unblock_ip. Library-only — nothing
# in tier1-perimeter calls these today. Intended caller: tier2-telemetry's
# `perimeter_block` detector action (opt-in per detector, not a default).
#
# [STUB: alias mutation + filter-reload calls are NOT live-verified against a
# real pfSense router in this codebase as of this commit — see the "DYNAMIC
# PERIMETER BLOCK — T0b" section in lib/api.sh for the exact gap.]
# -----------------------------------------------------------------------------

# Name of the SURU-owned dynamic block alias. Distinct from pfBlockerNG-managed
# pfB_* aliases — pfBlockerNG's own cron/Force-Reload cycle does NOT refresh
# this alias; lib/api.sh triggers its own filter reload after every mutation.
PERIMETER_BLOCK_ALIAS=pfB_SURU_DYNAMIC_v4

# Comma-separated IPs/CIDRs that must NEVER be blocked (router mgmt IP, SIEM
# host, operator/admin hosts). RFC1918, loopback, and ROUTER_HOST itself are
# ALWAYS protected as a hardcoded floor regardless of this setting — this var
# extends that floor, it cannot weaken it.
PERIMETER_BLOCK_ALLOWLIST=

# Block duration in seconds when api_block_ip is called without an explicit
# TTL. 0 is rejected — no permanent blocks without an explicit out-of-band
# decision (see risk R4 in the SIEM Security Analytics plan).
PERIMETER_BLOCK_DEFAULT_TTL=3600

# Hard ceiling on any TTL passed to api_block_ip, including explicit overrides.
PERIMETER_BLOCK_MAX_TTL=86400

# Rate limit: at most this many blocks per PERIMETER_BLOCK_WINDOW_SECONDS,
# enforced per calling host (state is local to the host running lib/api.sh —
# it does not coordinate across multiple callers/CI runners).
PERIMETER_BLOCK_MAX_PER_WINDOW=10
PERIMETER_BLOCK_WINDOW_SECONDS=300

# Directory for TTL + rate-limit bookkeeping on the CALLING host (not the
# router). Defaults to a tmp-backed path; for production use, point this at a
# persistent directory so a host reboot doesn't lose in-flight TTL state.
# PERIMETER_BLOCK_STATE_DIR=/var/lib/suru/perimeter-block
